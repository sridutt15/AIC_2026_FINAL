# KPI Intelligence-to-Action Engine — backend environment variables.
# Copy this file to `.env` and fill in real values. NEVER commit real secrets.

# Port the FastAPI backend listens on.
PORT=8000

# Postgres connection string — required (no SQLite fallback).
# Use the Transaction pooler connection string from Supabase (port 6543).
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Folder where raw uploaded source files are stored (relative to backend/ or absolute).
UPLOADS_DIR=data/uploads

# Gemini API key — required for Phase 10's LLM recommendation layer.
# Get one at https://aistudio.google.com/apikey. May be empty until then.
GEMINI_API_KEY=

# Gemini model for recommendations + published per-Mtok rates for cost estimation.
# Defaults below target gemini-3.6-flash pricing.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_INPUT_USD_PER_MTOK=0.10
GEMINI_OUTPUT_USD_PER_MTOK=0.40
# Secret key for signing JWTs (required).
# Generate with: openssl rand -hex 32
SECRET_KEY=<paste output of: openssl rand -hex 32>

# Access/refresh token lifetimes (defaults shown).
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase Storage (Phase 16) — find these in the Supabase dashboard:
# Project Settings -> API (URL) and the service-role key; bucket = Storage -> uploads (Private).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=<service-role key from Project Settings -> API>
SUPABASE_STORAGE_BUCKET=uploads
